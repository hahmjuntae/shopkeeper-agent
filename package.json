{
  "name": "shopkeeper-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev --port 8788",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "build:client": "esbuild client/app.tsx --bundle --minify --format=esm --jsx=automatic --outfile=public/app.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/react": "^4.0.170",
    "@cloudflare/ai-chat": "^0.12.2",
    "agents": "^0.33.0",
    "ai": "^7.0.165",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
